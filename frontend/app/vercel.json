{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "https://yosakoi-portal.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "destination": "https://yosakoi-portal.com/:path*",
      "statusCode": 301
    }
  ]
}
